// ===== 个人主页 · Signal 风格（navy + 米白 + 古金）=====
// 仅作用于首页（pageClass: home-portal），不影响文档页

// 让首页内容铺满，去掉默认窄栏
.home-portal .theme-default-content
  max-width 1180px
  padding 1.6rem 1.4rem 3rem

.home-portal .theme-default-content:not(.custom)
  max-width 1180px
  padding 1.6rem 1.4rem 3rem

.home-portal
  background #F1EDE4

.portal
  font-family 'DM Sans', -apple-system, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif
  color #1A2030

// ---------- HERO ----------
.portal .hero
  position relative
  overflow hidden
  border-radius 14px
  padding 3.4rem 3rem 3rem
  color #E2DCD0
  background linear-gradient(rgba(200,168,112,0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(200,168,112,0.045) 1px, transparent 1px), linear-gradient(135deg, #1C2644 0%, #232F55 100%)
  background-size 40px 40px, 40px 40px, 100% 100%
  box-shadow 0 18px 50px rgba(28,38,68,0.28)
  border 1px solid #2E3D5C

.portal .hero-inner
  position relative
  z-index 1

.portal .kicker
  font-family 'IBM Plex Mono', 'JetBrains Mono', monospace
  font-size 0.72rem
  letter-spacing 0.22em
  color #C8A870
  margin 0 0 1.1rem

.portal .hero-name
  font-family 'Source Serif 4', Georgia, 'Times New Roman', serif
  font-weight 700
  font-size 3rem
  line-height 1.02
  letter-spacing -0.01em
  margin 0
  color #F0ECE3

.portal .hero-name .gold
  color #C8A870
  font-weight 600
  font-style italic

.portal .hero-role
  font-family 'Source Serif 4', Georgia, serif
  font-size 1.35rem
  font-weight 500
  margin 0.7rem 0 0
  color #E2DCD0

.portal .hero-role .sep
  color #C8A870
  margin 0 0.4rem

.portal .hero-lead
  max-width 40rem
  font-size 0.98rem
  line-height 1.7
  color #8A96A8
  margin 1.1rem 0 0

// 技能标签
.portal .chips
  display flex
  flex-wrap wrap
  gap 0.5rem
  margin 1.6rem 0 0

.portal .chip
  font-family 'IBM Plex Mono', monospace
  font-size 0.72rem
  letter-spacing 0.04em
  padding 0.34rem 0.7rem
  border-radius 999px
  border 1px solid #2E3D5C
  color #B9C2D0
  background rgba(255,255,255,0.02)

.portal .chip-gold
  border-color rgba(200,168,112,0.55)
  color #C8A870
  background rgba(200,168,112,0.08)

// HERO 快捷链接
.portal .hero-links
  display flex
  flex-wrap wrap
  gap 1.3rem
  margin 1.9rem 0 0
  padding-top 1.4rem
  border-top 1px solid #2E3D5C

.portal .hero-links a
  font-family 'IBM Plex Mono', monospace
  font-size 0.8rem
  letter-spacing 0.04em
  color #E2DCD0
  text-decoration none
  transition color .18s ease

.portal .hero-links a:hover
  color #C8A870

// ---------- 卡片网格 ----------
.portal .grid
  display grid
  grid-template-columns repeat(auto-fill, minmax(270px, 1fr))
  gap 1.1rem
  margin 1.6rem 0 0

.portal .cat
  position relative
  background #FBFAF6
  border 1px solid #E2DAC9
  border-radius 12px
  padding 1.15rem 1.2rem 1.25rem
  transition transform .18s ease, box-shadow .18s ease, border-color .18s ease

.portal .cat:hover
  transform translateY(-3px)
  box-shadow 0 12px 28px rgba(28,38,68,0.12)
  border-color #C8A870

.portal .cat-head
  display flex
  align-items baseline
  gap 0.6rem
  padding-bottom 0.75rem
  margin-bottom 0.85rem
  border-bottom 1px solid #ECE5D6

.portal .cat-no
  font-family 'IBM Plex Mono', monospace
  font-size 0.72rem
  font-weight 500
  letter-spacing 0.06em
  color #fff
  background #1C2644
  padding 0.16rem 0.46rem
  border-radius 5px
  flex-shrink 0

.portal .cat-ai .cat-no
  background #C8A870
  color #1C2644

.portal .cat-head h3
  font-family 'Source Serif 4', Georgia, serif
  font-size 1.05rem
  font-weight 600
  margin 0
  color #1A2030
  border none
  padding 0

.portal .cat-links
  display flex
  flex-wrap wrap
  gap 0.45rem

.portal .cat-links a
  font-size 0.84rem
  line-height 1.2
  color #2C3744
  text-decoration none
  padding 0.36rem 0.66rem
  border-radius 7px
  background #F1ECE0
  border 1px solid transparent
  transition all .15s ease

.portal .cat-links a:hover
  color #1C2644
  background #fff
  border-color #C8A870
  box-shadow 0 2px 8px rgba(200,168,112,0.25)

.portal .cat-ai .cat-links a:hover
  color #8a6d2f

// ---------- 页脚 ----------
.portal .portal-foot
  display flex
  flex-wrap wrap
  align-items center
  gap 0.5rem
  margin 2.4rem 0 0
  padding-top 1.3rem
  border-top 1px solid #E2DAC9
  font-family 'IBM Plex Mono', monospace
  font-size 0.74rem
  letter-spacing 0.04em
  color #9AA0A8

.portal .portal-foot .foot-sep
  color #C8A870

.portal .portal-foot a
  color #5A6270
  text-decoration none
  border-bottom 1px solid #C8A870

.portal .portal-foot a:hover
  color #1C2644

// ---------- 响应式 ----------
@media (max-width: 720px)
  .portal .hero
    padding 2.4rem 1.5rem
  .portal .hero-name
    font-size 2.1rem
  .portal .hero-role
    font-size 1.1rem
  .home-portal .theme-default-content
    padding 1rem 0.9rem 2.4rem
