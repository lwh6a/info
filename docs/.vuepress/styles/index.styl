// ===== 个人主页 · Creative Mode（新粗野风）=====
// 米白纸 + 黑描边硬阴影 + 绿/粉/橙/黄四色块，Archivo Black 大写粗标
// 首页样式作用于 .home-portal；导航栏样式全站生效

// ---------- 全站导航栏 ----------
.navbar
  background #EFE9D9
  border-bottom 3px solid #0F0F0F
  box-shadow none

.navbar .site-name
  font-family 'Archivo Black', 'PingFang SC', 'Microsoft YaHei', sans-serif
  font-weight 800
  color #0F0F0F
  letter-spacing 0.01em

.navbar .links
  background-color #EFE9D9

.navbar .nav-link
  font-weight 600

.navbar .search-box input
  border 2px solid #0F0F0F
  border-radius 0
  background #FBF8EF

// ---------- 首页容器 ----------
.home-portal .theme-default-content
  max-width 1200px
  padding 1.6rem 1.4rem 3rem

.home-portal .theme-default-content:not(.custom)
  max-width 1200px
  padding 1.6rem 1.4rem 3rem

.home-portal
  background #EFE9D9

.portal
  font-family 'Space Grotesk', -apple-system, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif
  color #1A1A1A

// ---------- HERO ----------
.portal .hero
  position relative
  background #FBF8EF
  border 4px solid #0F0F0F
  box-shadow 8px 8px 0 #0F0F0F
  padding 0 0 2.4rem

.portal .hero-bar
  display flex
  height 14px
  border-bottom 4px solid #0F0F0F

.portal .hero-bar span
  flex 1

.portal .hero-bar .b-green
  background #1F8A4C
.portal .hero-bar .b-pink
  background #F06CA8
.portal .hero-bar .b-orange
  background #E85A1F
.portal .hero-bar .b-yellow
  background #F5C518

.portal .hero-inner
  padding 2.2rem 2.6rem 0

.portal .kicker
  font-family 'JetBrains Mono', 'IBM Plex Mono', monospace
  font-size 0.72rem
  letter-spacing 0.14em
  text-transform uppercase
  color #2A2A2A
  margin 0 0 1rem

.portal .hero-name
  font-family 'Archivo Black', 'PingFang SC', 'Microsoft YaHei', sans-serif
  font-weight 800
  font-size 3.2rem
  line-height 0.98
  letter-spacing -0.01em
  text-transform uppercase
  margin 0
  color #0F0F0F

.portal .hero-name .name-accent
  color #E85A1F

.portal .hero-role
  font-family 'Space Grotesk', sans-serif
  font-size 1.2rem
  font-weight 700
  text-transform uppercase
  letter-spacing 0.01em
  margin 0.9rem 0 0
  color #0F0F0F

.portal .hero-role .sep
  color #1F8A4C
  margin 0 0.4rem

.portal .hero-lead
  max-width 42rem
  font-size 0.98rem
  line-height 1.65
  color #2A2A2A
  margin 1rem 0 0

.portal .chips
  display flex
  flex-wrap wrap
  gap 0.5rem
  margin 1.5rem 0 0

.portal .chip
  font-family 'JetBrains Mono', monospace
  font-size 0.72rem
  letter-spacing 0.04em
  text-transform uppercase
  padding 0.34rem 0.7rem
  border 2px solid #0F0F0F
  background #EFE9D9
  color #0F0F0F

.portal .chip-ai
  background #1F8A4C
  color #EFE9D9

.portal .hero-links
  display flex
  flex-wrap wrap
  gap 0.7rem
  margin 1.6rem 0 0

.portal .hero-links a
  font-family 'JetBrains Mono', monospace
  font-size 0.78rem
  letter-spacing 0.03em
  color #0F0F0F
  text-decoration none
  padding 0.4rem 0.8rem
  border 2px solid #0F0F0F
  background #EFE9D9
  transition all .12s ease

.portal .hero-links a:hover
  background #E85A1F
  color #EFE9D9
  box-shadow 3px 3px 0 #0F0F0F

// ---------- 卡片网格 ----------
.portal .grid
  display grid
  grid-template-columns repeat(auto-fill, minmax(280px, 1fr))
  gap 1.3rem
  margin 1.6rem 0 0

.portal .cat
  background #FBF8EF
  border 3px solid #0F0F0F
  box-shadow 5px 5px 0 #0F0F0F
  padding 0
  transition transform .12s ease, box-shadow .12s ease

.portal .cat:hover
  transform translate(-2px, -2px)
  box-shadow 7px 7px 0 #0F0F0F

.portal .cat-head
  display flex
  align-items center
  gap 0.6rem
  padding 0.7rem 0.95rem
  border-bottom 3px solid #0F0F0F

.portal .cat-no
  font-family 'Archivo Black', sans-serif
  font-size 0.86rem
  color #EFE9D9
  background #0F0F0F
  padding 0.16rem 0.5rem
  flex-shrink 0

.portal .cat-head h3
  display flex
  align-items baseline
  gap 0.5rem
  flex-wrap wrap
  margin 0
  border none
  padding 0

.portal .cat-head h3 .zh
  font-family 'Archivo Black', 'PingFang SC', 'Microsoft YaHei', sans-serif
  font-weight 800
  font-size 1.02rem

.portal .cat-head h3 .en
  font-family 'JetBrains Mono', monospace
  font-size 0.62rem
  font-weight 500
  letter-spacing 0.08em
  text-transform uppercase
  opacity 0.8

.portal .cat-links
  display flex
  flex-wrap wrap
  gap 0.45rem
  padding 0.9rem 0.95rem 1rem

.portal .cat-links a
  font-size 0.82rem
  line-height 1.2
  color #0F0F0F
  text-decoration none
  padding 0.34rem 0.6rem
  border 2px solid #0F0F0F
  background #EFE9D9
  transition all .1s ease

.portal .cat-links a:hover
  box-shadow 2px 2px 0 #0F0F0F

// ---------- 卡片四色循环：绿 / 粉 / 橙 / 黄 ----------
.portal .cat:nth-child(4n+1) .cat-head
  background #1F8A4C
.portal .cat:nth-child(4n+1) .cat-head h3 .zh
  color #EFE9D9
.portal .cat:nth-child(4n+1) .cat-head h3 .en
  color #EFE9D9
.portal .cat:nth-child(4n+1) .cat-links a:hover
  background #1F8A4C
  color #EFE9D9

.portal .cat:nth-child(4n+2) .cat-head
  background #F06CA8
.portal .cat:nth-child(4n+2) .cat-head h3 .zh
  color #0F0F0F
.portal .cat:nth-child(4n+2) .cat-head h3 .en
  color #0F0F0F
.portal .cat:nth-child(4n+2) .cat-links a:hover
  background #F06CA8
  color #0F0F0F

.portal .cat:nth-child(4n+3) .cat-head
  background #E85A1F
.portal .cat:nth-child(4n+3) .cat-head h3 .zh
  color #EFE9D9
.portal .cat:nth-child(4n+3) .cat-head h3 .en
  color #EFE9D9
.portal .cat:nth-child(4n+3) .cat-links a:hover
  background #E85A1F
  color #EFE9D9

.portal .cat:nth-child(4n+4) .cat-head
  background #F5C518
.portal .cat:nth-child(4n+4) .cat-head h3 .zh
  color #0F0F0F
.portal .cat:nth-child(4n+4) .cat-head h3 .en
  color #0F0F0F
.portal .cat:nth-child(4n+4) .cat-links a:hover
  background #F5C518
  color #0F0F0F

// ---------- 页脚 ----------
.portal .portal-foot
  display flex
  flex-wrap wrap
  align-items center
  gap 0.5rem
  margin 2.6rem 0 0
  padding-top 1.3rem
  border-top 3px solid #0F0F0F
  font-family 'JetBrains Mono', monospace
  font-size 0.74rem
  letter-spacing 0.03em
  text-transform uppercase
  color #2A2A2A

.portal .portal-foot .foot-sep
  color #E85A1F

.portal .portal-foot a
  color #0F0F0F
  text-decoration none
  border-bottom 2px solid #1F8A4C

.portal .portal-foot a:hover
  color #1F8A4C

// ---------- 响应式 ----------
@media (max-width: 720px)
  .portal .hero-inner
    padding 1.8rem 1.3rem 0
  .portal .hero-name
    font-size 2.2rem
  .portal .hero-role
    font-size 1rem
  .home-portal .theme-default-content
    padding 1rem 0.9rem 2.4rem
