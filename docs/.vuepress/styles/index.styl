// ===== 个人主页 · 组合编辑风 =====
// 森林绿 + 暖米白 + 柠檬黄 + 墨水蓝，粉色仅用于文字
// 仅作用于首页（pageClass: home-portal），不影响文档页

// 让首页内容铺满，去掉默认窄栏
.home-portal .theme-default-content
  max-width 1180px
  padding 1.6rem 1.4rem 3rem

.home-portal .theme-default-content:not(.custom)
  max-width 1180px
  padding 1.6rem 1.4rem 3rem

.home-portal
  background #F1ECDE

.portal
  font-family 'DM Sans', -apple-system, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif
  color #233029

// ---------- HERO ----------
.portal .hero
  position relative
  overflow hidden
  border-radius 14px
  padding 3.4rem 3rem 3rem
  color #F0EBDD
  background linear-gradient(rgba(201,217,74,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(201,217,74,0.05) 1px, transparent 1px), linear-gradient(135deg, #1C3A27 0%, #2A5238 100%)
  background-size 38px 38px, 38px 38px, 100% 100%
  box-shadow 0 18px 50px rgba(28,58,39,0.26)
  border 1px solid #2E4D38

.portal .hero-inner
  position relative
  z-index 1

.portal .kicker
  font-family 'IBM Plex Mono', 'JetBrains Mono', monospace
  font-size 0.72rem
  letter-spacing 0.22em
  color #C9D94A
  margin 0 0 1.1rem

.portal .hero-name
  font-family 'Source Serif 4', Georgia, 'Times New Roman', serif
  font-weight 700
  font-size 3rem
  line-height 1.02
  letter-spacing -0.01em
  margin 0
  color #F4F0E4

// 名字强调 —— 粉色（仅文字）
.portal .hero-name .name-accent
  color #E59FB0
  font-weight 600
  font-style italic

.portal .hero-role
  font-family 'Source Serif 4', Georgia, serif
  font-size 1.35rem
  font-weight 500
  margin 0.7rem 0 0
  color #E7E1D2

.portal .hero-role .sep
  color #C9D94A
  margin 0 0.4rem

.portal .hero-lead
  max-width 40rem
  font-size 0.98rem
  line-height 1.7
  color #9FB4A4
  margin 1.1rem 0 0

// 技能标签
.portal .chips
  display flex
  flex-wrap wrap
  gap 0.5rem
  margin 1.6rem 0 0

.portal .chip
  font-family 'IBM Plex Mono', monospace
  font-size 0.72rem
  letter-spacing 0.04em
  padding 0.34rem 0.7rem
  border-radius 999px
  border 1px solid #34543F
  color #C4D2C7
  background rgba(255,255,255,0.02)

.portal .chip-ai
  border-color rgba(201,217,74,0.5)
  color #C9D94A
  background rgba(201,217,74,0.08)

// HERO 快捷链接
.portal .hero-links
  display flex
  flex-wrap wrap
  gap 1.3rem
  margin 1.9rem 0 0
  padding-top 1.4rem
  border-top 1px solid #34543F

.portal .hero-links a
  font-family 'IBM Plex Mono', monospace
  font-size 0.8rem
  letter-spacing 0.04em
  color #E7E1D2
  text-decoration none
  transition color .18s ease

.portal .hero-links a:hover
  color #C9D94A

// ---------- 卡片网格 ----------
.portal .grid
  display grid
  grid-template-columns repeat(auto-fill, minmax(270px, 1fr))
  gap 1.1rem
  margin 1.6rem 0 0

.portal .cat
  position relative
  background #FBF8EF
  border 1px solid #E2D9C4
  border-radius 12px
  padding 1.15rem 1.2rem 1.25rem
  transition transform .18s ease, box-shadow .18s ease, border-color .18s ease

.portal .cat:hover
  transform translateY(-3px)
  box-shadow 0 12px 26px rgba(28,58,39,0.14)
  border-color #20422D

.portal .cat-head
  display flex
  align-items baseline
  gap 0.6rem
  padding-bottom 0.75rem
  margin-bottom 0.85rem
  border-bottom 1px solid #ECE4D2

.portal .cat-no
  font-family 'IBM Plex Mono', monospace
  font-size 0.72rem
  font-weight 500
  letter-spacing 0.06em
  color #F4F0E4
  background #20422D
  padding 0.16rem 0.46rem
  border-radius 5px
  flex-shrink 0

.portal .cat-ai .cat-no
  background #C9D94A
  color #20422D

.portal .cat-head h3
  display flex
  align-items baseline
  gap 0.5rem
  flex-wrap wrap
  font-size 1.05rem
  font-weight 600
  margin 0
  border none
  padding 0

.portal .cat-head h3 .zh
  font-family 'Source Serif 4', Georgia, serif
  color #20422D

// 英文小标 —— 粉色（仅文字）
.portal .cat-head h3 .en
  font-family 'IBM Plex Mono', monospace
  font-size 0.66rem
  font-weight 500
  letter-spacing 0.08em
  text-transform uppercase
  color #D98AA0

.portal .cat-links
  display flex
  flex-wrap wrap
  gap 0.45rem

.portal .cat-links a
  font-size 0.84rem
  line-height 1.2
  color #2C3A30
  text-decoration none
  padding 0.36rem 0.66rem
  border-radius 7px
  background #EFE8D6
  border 1px solid transparent
  transition all .15s ease

.portal .cat-links a:hover
  color #1B3A8C
  background #fff
  border-color #1B3A8C
  box-shadow 0 2px 8px rgba(27,58,140,0.16)

// ---------- 页脚 ----------
.portal .portal-foot
  display flex
  flex-wrap wrap
  align-items center
  gap 0.5rem
  margin 2.4rem 0 0
  padding-top 1.3rem
  border-top 1px solid #E2D9C4
  font-family 'IBM Plex Mono', monospace
  font-size 0.74rem
  letter-spacing 0.04em
  color #6E7A63

// 分隔符 —— 粉色（仅文字）
.portal .portal-foot .foot-sep
  color #D98AA0

.portal .portal-foot a
  color #4A5A4E
  text-decoration none
  border-bottom 1px solid #20422D

.portal .portal-foot a:hover
  color #1B3A8C

// ---------- 响应式 ----------
@media (max-width: 720px)
  .portal .hero
    padding 2.4rem 1.5rem
  .portal .hero-name
    font-size 2.1rem
  .portal .hero-role
    font-size 1.1rem
  .home-portal .theme-default-content
    padding 1rem 0.9rem 2.4rem
